{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pages-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "wrangler@3",
        "pages",
        "dev",
        ".",
        "--port",
        "8788",
        "--kv",
        "USERS",
        "--binding",
        "OWNER_EMAIL=owner@example.test",
        "--binding",
        "FRIEND_EMAILS=friend@example.test,friend2@example.test",
        "--binding",
        "USER_KEYS_SECRET=local-dev-only-secret"
      ],
      "port": 8788
    }
  ]
}
